---
import Layout from '../layouts/Layout.astro';
import TechCarousel from '../components/TechCarousel.astro';
import brandLogo from '../assets/informaticasuperior.png';

const seo = {
	title: 'Informática Superior | Desarrollo Web y Software',
	description:
		'Informática Superior diseña páginas web, tiendas online y software a medida para negocios que quieren crecer digitalmente.',
};
---

<Layout seo={seo}>
	<header class="topbar">
		<div class="container nav">
			<div class="brand">
				<img class="brand-logo" src={brandLogo.src} alt="" width="42" height="54" />
				<span>Informática Superior</span>
			</div>
			<nav class="nav-links">
				<a href="#servicios">Servicios</a>
				<a href="#soluciones">Soluciones</a>
				<a href="#proceso">Proceso</a>
				<a href="#contacto">Contacto</a>
			</nav>
			<a class="btn btn-primary" href="#contacto">Solicitar presupuesto</a>
		</div>
	</header>

	<main>
		<section class="hero">
			<img class="hero-watermark" src={brandLogo.src} alt="" aria-hidden="true" />
			<div class="container hero-grid">
				<div class="hero-copy" data-reveal>
					<p class="eyebrow">Tecnología que toma impulso</p>
					<h1>Soluciones digitales para negocios que quieren crecer.</h1>
					<p class="lead">
						Informática Superior diseña páginas web, tiendas online y software a medida para ayudar a empresas a
						mejorar su presencia digital, vender más y optimizar sus procesos internos.
					</p>
					<div class="hero-actions">
						<a class="btn btn-primary" href="#contacto">Hablemos</a>
						<a class="btn btn-secondary" href="#servicios">Ver servicios</a>
					</div>
					<ul class="hero-stats">
						<li><strong>+120</strong><span>proyectos</span></li>
						<li><strong>4.9/5</strong><span>calificación</span></li>
						<li><strong>30 días</strong><span>promedio de entrega</span></li>
					</ul>
				</div>

				<div class="hero-visual" data-reveal="right">
					<!-- <div class="orbit-label orbit-label-top">Estrategia</div>
					<div class="orbit-label orbit-label-bottom">Evolución</div> -->
					<div class="dashboard-card">
						<div class="card-header">
							<span class="dot green"></span>
							<span class="dot yellow"></span>
							<span class="dot red"></span>
						</div>
						<div class="mini-chart">
							<div class="chart-bars">
								<span style="height: 30%"></span>
								<span style="height: 45%"></span>
								<span style="height: 58%"></span>
								<span style="height: 72%"></span>
								<span style="height: 88%"></span>
							</div>
							<div class="chart-panel">
								<p>Ventas</p>
								<strong>+42%</strong>
							</div>
						</div>
						<div class="metrics-grid">
							<div>
								<span>Leads</span>
								<strong>1.2k</strong>
							</div>
							<div>
								<span>CTR</span>
								<strong>8.4%</strong>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="logos">
			<div class="container logos-row" data-reveal>
				<span>Confían en nosotros</span>
				<div class="logos-list">
					<span>ShopFlow</span>
					<span>BluePeak</span>
					<span>NexaLab</span>
					<span>NovaPay</span>
					<span>UrbanCart</span>
				</div>
			</div>
		</section>

		<section id="servicios" class="section">
			<div class="container">
				<div class="section-head">
					<p class="eyebrow">Servicios</p>
					<h2>Todo lo que necesitas para crecer online.</h2>
				</div>

				<div class="cards-grid">
					<article class="service-card" data-reveal>
						<div class="icon">01</div>
						<h3>Software a medida</h3>
						<p>
							Soluciones personalizadas para automatizar tareas, mejorar procesos internos y
							apoyar el crecimiento de tu negocio.
						</p>
					</article>

					<article class="service-card" data-reveal>
						<div class="icon">02</div>
						<h3>Páginas web</h3>
						<p>
							Sitios modernos, rápidos y orientados a conversión para captar clientes,
							presentar tu marca y aumentar tu credibilidad.
						</p>
					</article>

					<article class="service-card" data-reveal>
						<div class="icon">03</div>
						<h3>Ecommerce</h3>
						<p>
							Tiendas online diseñadas para vender mejor, mejorar la experiencia del cliente y
							potenciar tus ventas desde cualquier dispositivo.
						</p>
					</article>
				</div>
			</div>
		</section>

		<TechCarousel />

		<section id="soluciones" class="section alt">
			<div class="container split">
				<div data-reveal>
					<p class="eyebrow">Por qué elegirnos</p>
					<h2>Diseño serio, tecnología sólida y enfoque comercial.</h2>
				</div>
				<div class="benefits-list" data-reveal="right">
					<div class="benefit">
						<strong>01</strong>
						<p>Soluciones pensadas para resultados reales: ventas, leads, eficiencia y crecimiento.</p>
					</div>
					<div class="benefit">
						<strong>02</strong>
						<p>Proceso claro, comunicación directa y entregas con foco en el negocio.</p>
					</div>
					<div class="benefit">
						<strong>03</strong>
						<p>Stack moderno, desarrollo escalable y atención post-lanzamiento.</p>
					</div>
				</div>
			</div>
		</section>

		<section id="proceso" class="section">
			<div class="container">
				<div class="section-head">
					<p class="eyebrow">Proceso</p>
					<h2>Un camino simple para convertir tu idea en producto.</h2>
				</div>

				<div class="steps-grid">
					<div class="step" data-reveal>
						<span>1</span>
						<h3>Diagnóstico</h3>
						<p>Analizamos tus objetivos, audiencia y necesidades reales.</p>
					</div>
					<div class="step" data-reveal>
						<span>2</span>
						<h3>Propuesta</h3>
						<p>Definimos alcance, funcionalidades, presupuesto y roadmap.</p>
					</div>
					<div class="step" data-reveal>
						<span>3</span>
						<h3>Diseño</h3>
						<p>Diseñamos interfaces enfocadas en claridad, experiencia y conversión.</p>
					</div>
					<div class="step" data-reveal>
						<span>4</span>
						<h3>Desarrollo</h3>
						<p>Construimos la solución con tecnología moderna y buenas prácticas.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section alt">
			<div class="container">
				<div class="section-head">
					<p class="eyebrow">Resultados</p>
					<h2>Lo que genera una presencia digital bien hecha.</h2>
				</div>

				<div class="stats-grid">
					<div class="stat-box" data-reveal>
						<strong>+60%</strong>
						<span>más engagement</span>
					</div>
					<div class="stat-box" data-reveal>
						<strong>+3x</strong>
						<span>más velocidad de venta</span>
					</div>
					<div class="stat-box" data-reveal>
						<strong>24/7</strong>
						<span>presencia digital activa</span>
					</div>
					<div class="stat-box" data-reveal>
						<strong>SEO</strong>
						<span>mejor posicionamiento</span>
					</div>
				</div>
			</div>
		</section>

		<section class="section testimonials">
			<div class="container">
				<div class="section-head">
					<p class="eyebrow">Testimonios</p>
					<h2>Clientes que ya vieron resultados.</h2>
				</div>

				<div class="testimonial-grid">
					<blockquote data-reveal>
						“Nos ayudaron a rediseñar nuestra web y a mejorar la experiencia de compra. En pocos meses
						mejoramos la conversión de clientes.”
						<footer>Marina López — UrbanCart</footer>
					</blockquote>
					<blockquote data-reveal>
						“Necesitábamos un sistema para gestionar pedidos y operaciones internas. Lo entregaron con una
						estructura clara y muy usable.”
						<footer>Diego Ruiz — NexaLab</footer>
					</blockquote>
				</div>
			</div>
		</section>

		<section id="contacto" class="section cta-section">
			<div class="container cta-box" data-reveal>
				<div>
					<p class="eyebrow">¿Listo para tu próximo proyecto?</p>
					<h2>Hagamos algo que te ayude a vender más y operar mejor.</h2>
				</div>
				<a class="btn btn-primary" href="mailto:hola@informaticasuperior.com">hola@informaticasuperior.com</a>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-inner">
			<p>© 2026 Informática Superior</p>
			<div>
				<a href="#servicios">Servicios</a>
				<a href="#proceso">Proceso</a>
				<a href="#contacto">Contacto</a>
			</div>
		</div>
	</footer>
</Layout>

<script>
	const revealElements = document.querySelectorAll<HTMLElement>('[data-reveal]');
	document.documentElement.classList.add('js');

	const revealObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					revealObserver.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.14 },
	);

	revealElements.forEach((element) => revealObserver.observe(element));
</script>

<style>
	.js [data-reveal] {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.js [data-reveal="right"] {
		transform: translateX(24px);
	}

	.js [data-reveal].is-visible {
		opacity: 1;
		transform: translate(0);
	}

	.cards-grid [data-reveal]:nth-child(2),
	.steps-grid [data-reveal]:nth-child(2),
	.stats-grid [data-reveal]:nth-child(2),
	.testimonial-grid [data-reveal]:nth-child(2) {
		transition-delay: 0.08s;
	}

	.cards-grid [data-reveal]:nth-child(3),
	.steps-grid [data-reveal]:nth-child(3),
	.stats-grid [data-reveal]:nth-child(3) {
		transition-delay: 0.16s;
	}

	.steps-grid [data-reveal]:nth-child(4),
	.stats-grid [data-reveal]:nth-child(4) {
		transition-delay: 0.24s;
	}

	@media (prefers-reduced-motion: reduce) {
		.js [data-reveal],
		.js [data-reveal="right"] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	.container {
		width: min(1120px, calc(100% - 32px));
		margin: 0 auto;
	}

	.topbar {
		position: sticky;
		top: 0;
		z-index: 10;
		backdrop-filter: blur(12px);
		background: rgba(255, 255, 255, 0.78);
		border-bottom: 1px solid var(--line);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 22px 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 800;
		letter-spacing: 0.02em;
	}

	.brand-logo {
		display: block;
		width: 42px;
		height: 54px;
		object-fit: contain;
	}

	.nav-links {
		display: flex;
		gap: 28px;
		color: var(--muted);
		font-size: 0.96rem;
	}

	.nav-links a:hover {
		color: var(--text);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 0.9rem 1.4rem;
		border-radius: 2px;
		clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
		font-weight: 700;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn-primary {
		background: linear-gradient(135deg, var(--primary), var(--primary-strong));
		color: #ffffff;
		box-shadow: 0 14px 26px rgba(12, 61, 82, 0.2);
	}

	.btn-secondary {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--line);
	}

	.hero {
		position: relative;
		overflow: hidden;
		padding: 104px 0 66px;
	}

	.hero-watermark {
		position: absolute;
		z-index: 0;
		top: 50%;
		right: clamp(-40px, 8vw, 130px);
		width: clamp(700px, 76vw, 1050px);
		height: auto;
		opacity: 0.2;
		transform: translateY(-50%) rotate(-8deg);
		pointer-events: none;
		user-select: none;
	}

	.hero-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		align-items: center;
		gap: 52px;
	}

	.eyebrow {
		margin: 0 0 14px;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--primary);
	}

	.hero-copy h1,
	.section-head h2,
	.split h2,
	.cta-box h2 {
		margin: 0;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.hero-copy h1 {
		font-size: clamp(2.8rem, 5vw, 5rem);
		max-width: 650px;
	}

	.hero-copy h1::first-line { color: var(--primary-strong); }

	.lead {
		max-width: 620px;
		margin-top: 22px;
		font-size: 1.08rem;
		color: var(--muted);
	}

	.hero-actions {
		display: flex;
		gap: 16px;
		margin-top: 28px;
		flex-wrap: wrap;
	}

	.hero-stats {
		list-style: none;
		display: flex;
		gap: 28px;
		padding: 0;
		margin: 38px 0 0;
		flex-wrap: wrap;
	}

	.hero-stats li {
		display: grid;
		gap: 6px;
	}

	.hero-stats strong {
		font-size: 1.5rem;
		color: var(--text);
	}

	.hero-stats span {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.hero-visual {
		position: relative;
		display: flex;
		justify-content: center;
	}

	.orbit-label {
		position: absolute;
		z-index: 2;
		padding: 7px 12px;
		background: var(--accent);
		color: #f8f9f4;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		clip-path: polygon(7px 0, 100% 0, calc(100% - 7px) 100%, 0 100%);
	}

	.orbit-label-top { top: -20px; right: 5%; transform: rotate(8deg); }
	.orbit-label-bottom { bottom: -22px; left: 4%; background: var(--primary); transform: rotate(-8deg); }

	.dashboard-card {
		width: min(100%, 520px);
		padding: 22px;
		border: 1px solid var(--line);
		border-radius: 0;
		background: var(--panel);
		clip-path: polygon(0 18px, 18px 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%);
		box-shadow: var(--shadow);
	}

	.card-header {
		display: flex;
		gap: 8px;
		margin-bottom: 18px;
	}

	.dot {
		display: inline-block;
		width: 12px;
		height: 12px;
		border-radius: 0;
		transform: rotate(45deg);
	}

	.dot.green { background: #34d399; }
	.dot.yellow { background: #fbbf24; }
	.dot.red { background: #f87171; }

	.mini-chart {
		display: grid;
		grid-template-columns: 1fr 180px;
		gap: 16px;
		padding: 16px;
		border-radius: 0;
		clip-path: polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--line);
	}

	.chart-bars {
		display: flex;
		align-items: end;
		gap: 10px;
		height: 160px;
		padding-top: 22px;
	}

	.chart-bars span {
		display: block;
		flex: 1;
		border-radius: 12px 12px 0 0;
		background: linear-gradient(180deg, var(--accent), var(--primary));
	}

	.chart-panel {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 18px;
		border-radius: 0;
		background: linear-gradient(135deg, rgba(23, 98, 122, 0.1), rgba(22, 160, 65, 0.1));
		border: 1px solid rgba(23, 98, 122, 0.18);
	}

	.chart-panel p,
	.metrics-grid span,
	.stat-box span,
	.benefit p,
	.step p,
	.service-card p,
	.testimonial-grid blockquote,
	.footer-inner p,
	.footer-inner a {
		color: var(--muted);
	}

	.chart-panel strong {
		font-size: 2rem;
		margin-top: 10px;
	}

	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		margin-top: 18px;
	}

	.metrics-grid div {
		padding: 18px;
		border-radius: 0;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--line);
	}

	.metrics-grid strong {
		display: block;
		margin-top: 8px;
		font-size: 1.5rem;
	}

	.logos {
		padding: 18px 0 18px;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.015);
	}

	.logos-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 22px;
		flex-wrap: wrap;
	}

	.logos-row > span {
		color: var(--muted);
		font-size: 0.9rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.logos-list {
		display: flex;
		gap: 28px;
		flex-wrap: wrap;
		color: rgba(230, 238, 252, 0.75);
		font-weight: 700;
	}

	.section {
		padding: 110px 0;
	}

	.alt {
		background: rgba(255, 255, 255, 0.015);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.section-head {
		margin-bottom: 40px;
	}

	.section-head h2,
	.split h2,
	.cta-box h2 {
		font-size: clamp(2rem, 4vw, 3.2rem);
		max-width: 700px;
	}

	.cards-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.service-card,
	.step,
	.stat-box,
	.testimonial-grid blockquote {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 0;
		clip-path: polygon(0 14px, 14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
		padding: 24px;
	}

	.service-card {
		min-height: 260px;
	}

	.icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		border-radius: 0;
		background: rgba(23, 98, 122, 0.1);
		clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);
		color: var(--primary);
		font-weight: 800;
		margin-bottom: 18px;
	}

	.service-card h3,
	.step h3 {
		margin: 0 0 12px;
		font-size: 1.5rem;
	}

	.split {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		align-items: start;
		gap: 30px;
	}

	.benefits-list {
		display: grid;
		gap: 18px;
	}

	.benefit {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: 18px;
		padding: 20px 0;
		border-bottom: 1px solid var(--line);
	}

	.benefit strong {
		display: inline-grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 0;
		background: rgba(22, 160, 65, 0.12);
		clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);
		color: var(--primary);
		font-size: 1rem;
	}

	.benefit p {
		margin: 0;
	}

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}

	.step span {
		display: inline-grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 0;
		font-weight: 800;
		background: linear-gradient(135deg, rgba(23, 98, 122, 0.12), rgba(22, 160, 65, 0.12));
		color: var(--primary);
		margin-bottom: 20px;
	}

	.step p {
		margin: 0;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 22px;
	}

	.stat-box {
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.stat-box strong {
		font-size: clamp(2rem, 3vw, 3rem);
		margin-bottom: 8px;
	}

	.testimonial-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
	}

