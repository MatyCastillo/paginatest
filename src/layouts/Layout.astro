---
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';

const seo = Astro.props?.seo ?? {};
const siteName = 'Informática Superior';
const pageTitle = seo.title ?? 'Informática Superior | Desarrollo Web y Software';
const pageDescription =
	seo.description ??
	'Informática Superior crea sitios web, ecommerce y soluciones de software a medida para negocios que quieren crecer digitalmente.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://matycastillo.github.io').toString();
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />

		<Seo
			title={pageTitle}
			description={pageDescription}
			siteName={siteName}
			canonical={canonical}
			openGraph={{
				basic: {
					title: pageTitle,
					type: 'website',
					url: canonical,
				},
				optional: {
					description: pageDescription,
					locale: 'es_ES',
				},
			}}
			twitter={{
				card: 'summary_large_image',
				site: '@informaticasuperior',
				creator: '@informaticasuperior',
			}}
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg: #f3f4ef;
		--bg-soft: #e7ece8;
		--panel: #fbfcf8;
		--panel-strong: #dce8e7;
		--primary: #17627a;
		--primary-strong: #0c3d52;
		--accent: #16a041;
		--accent-strong: #08712f;
		--text: #10232a;
		--muted: #53656a;
		--line: rgba(16, 35, 42, 0.14);
		--card: #fbfcf8;
		--shadow: 0 24px 55px rgba(12, 61, 82, 0.13);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
		background:
			linear-gradient(135deg, rgba(22, 160, 65, 0.05) 0 1px, transparent 1px 32px),
			linear-gradient(180deg, #f8f9f4 0%, var(--bg-soft) 100%);
		background-size: 32px 32px, 100% 100%;
		color: var(--text);
		line-height: 1.6;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		max-width: 100%;
		display: block;
	}
</style>
